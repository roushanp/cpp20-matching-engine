{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build/Debug",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build/Debug"
      ],
      "dependsOn": "CMake: Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build/Release",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build/Release"
      ],
      "dependsOn": "CMake: Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "CTest: Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir", "build/Debug",
        "--output-on-failure"
      ],
      "dependsOn": "CMake: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": "test"
    },
    {
      "label": "CTest: Release",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir", "build/Release",
        "--output-on-failure"
      ],
      "dependsOn": "CMake: Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": "test"
    }
  ]
}
